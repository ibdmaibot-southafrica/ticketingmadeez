GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
GHL_APP_ID=6a5e75aeb65bde58d9968235
GHL_API_BASE=https://services.leadconnectorhq.com
GHL_API_VERSION=2021-07-28

APP_BASE_URL=https://ticketing.nexbdm.co.za

# Postgres on the Hetzner box, e.g. postgres://tmez_user:PASSWORD@127.0.0.1:5432/ticketingmadeez
DATABASE_URL=
# Set to "true" only if the connection is over public internet with a self-signed cert
DATABASE_SSL=false

GHL_APP_SHARED_SECRET=
SESSION_SECRET=

# Customer-owned OpenAI keys are entered in the app and encrypted per location.
# Never configure a publisher AI API key. There is no publisher-key fallback.
# Optional dedicated encryption secret, at least 32 characters. Otherwise SESSION_SECRET is used.
# Preserve this secret across deployments. Rotation requires migration or customer key re-entry.
AI_CREDENTIALS_KEY=
# Recommended pinned model and verified USD rates per million tokens.
TMEZ_AI_MODEL=gpt-5.4-mini-2026-03-17
TMEZ_AI_INPUT_USD_PER_MILLION=0.75
TMEZ_AI_OUTPUT_USD_PER_MILLION=4.5
# Global daily request ceiling. Zero is an operator emergency halt.
# Accounts still start off and require their own key, billing acknowledgement and budget.
TMEZ_AI_DAILY_LIMIT=1000
